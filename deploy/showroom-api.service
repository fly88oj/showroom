[Unit]
Description=Showroom control-plane API
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
# 站点对外地址经可选 env 文件提供（缺省回落代码内置 http://127.0.0.1）：
# 部署时写入 /etc/showroom/showroom.env 一行：SHOWROOM_BASE_URL=http://<your-host>
EnvironmentFile=-/etc/showroom/showroom.env
ExecStart=/usr/local/bin/showroomctl serve
Restart=always
RestartSec=3
# 状态与配置都在 /srv/showroom
WorkingDirectory=/srv/showroom

[Install]
WantedBy=multi-user.target
