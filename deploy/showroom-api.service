[Unit]
Description=Showroom control-plane API
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
# 模板锚点：setup 的 render_unit_api 会把下面这行替换为
# Environment=SHOWROOM_BASE_URL=http://<host.env LAN_HOST>（host.env 首跑探测/覆写）。
EnvironmentFile=-/etc/showroom/showroom.env
ExecStart=/usr/local/bin/showroomctl serve
Restart=always
RestartSec=3
# 状态与配置都在 /srv/showroom
WorkingDirectory=/srv/showroom

[Install]
WantedBy=multi-user.target
