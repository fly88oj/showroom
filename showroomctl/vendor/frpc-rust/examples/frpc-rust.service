[Unit]
Description=Rust frp client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frpc
Group=frpc
WorkingDirectory=/etc/frpc-rust
ExecStart=/usr/local/bin/frpc-rust -c /etc/frpc-rust/frpc.toml
ExecReload=/usr/local/bin/frpc-rust -c /etc/frpc-rust/frpc.toml reload
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
